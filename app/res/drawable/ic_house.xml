<?xml version="1.0" encoding="utf-8"?>
<!-- App icon: a simple light-grey house with two window holes. Used twice in
     ic_launcher.xml: as the normal icon (on the dark grey background) and as the
     "monochrome" layer that Pixel's Themed icons recolors to match the wallpaper.
     One path, even-odd fill, so the windows are real holes. The thick round
     stroke is what rounds the corners (and it shrinks each 15-wide hole to 11). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- drawn on a 100-wide circle, then shrunk into the part launchers show -->
    <group
        android:scaleX="0.72"
        android:scaleY="0.72"
        android:translateX="18"
        android:translateY="17">
        <path
            android:pathData="M50,29L77,52V79H23V52ZM31,55h15v15h-15ZM54,55h15v15h-15Z"
            android:fillType="evenOdd"
            android:fillColor="#d5dae6"
            android:strokeColor="#d5dae6"
            android:strokeWidth="4"
            android:strokeLineJoin="round" />
    </group>
</vector>
