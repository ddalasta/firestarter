<?xml version="1.0" encoding="utf-8"?>
<!-- Fireplace app: a tiny wrapper that opens the remote page from the fireplace box
     full-screen. Sideloaded on the family's phones (not in the Play Store). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.firestarter.remote">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- usesCleartextTraffic: the box's address is plain http (it is only on home WiFi) -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
